# Aplikasi
PORT=8000

# JWT Access Token (WAJIB). Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Masa berlaku access token dalam menit (default: 15)
JWT_ACCESS_TTL_MINUTES=15

# JWT Refresh Token (opsional, default: access_secret + "-refresh")
JWT_REFRESH_SECRET=
# Masa berlaku refresh token dalam jam (default: 720 = 30 hari)
JWT_REFRESH_TTL_HOURS=720

# CORS allowed origins (koma-separated, default: * untuk development)
# Production: CORS_ALLOWED_ORIGINS=https://app.lattepos.com
CORS_ALLOWED_ORIGINS=*

# Legacy (backward-compatible, dipakai jika JWT_ACCESS_SECRET kosong)
JWT_SECRET=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=disable
